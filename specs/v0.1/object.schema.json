{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orybit.dev/specs/v0.1/object.schema.json",
  "title": "ORYBIT Object",
  "description": "A persistent digital representation of a physical object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "publicId",
    "kind",
    "identity",
    "lifecycle",
    "carriers",
    "capabilities"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^obj_[A-Za-z0-9_-]+$"
    },
    "publicId": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "appliance",
        "tool",
        "vehicle-component",
        "bicycle"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "lost",
            "retired"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "carriers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "uri"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "qr",
              "nfc",
              "barcode",
              "ble",
              "other"
            ]
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
