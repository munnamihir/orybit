{
  "name": "orybit-api",
  "main": "workers/api/src/worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/v1/*",
      "/public/*",
      "/manifest/*"
    ]
  },
  "secrets": {
    "required": [
      "ORYBIT_ADMIN_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orybit-registry",
      "database_id": "a81eef1c-9e4c-4ef9-ba6d-fd9a4ab7a667"
    }
  ]
}
